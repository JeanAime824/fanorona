rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.email is string
        && request.resource.data.displayName is string;
      allow update: if isValidId(userId) && isOwner(userId)
        && request.resource.data.id == userId
        && request.resource.data.email == resource.data.email;
      allow delete: if false;

      // Cumulative Stats and synced settings
      match /stats/{statId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create, update: if isValidId(userId) && isOwner(userId)
          && request.resource.data.userId == userId;
        allow delete: if false;
      }

      // Historical completed games
      match /games/{gameId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId)
          && request.resource.data.userId == userId;
        allow update, delete: if false;
      }
    }
  }
}
