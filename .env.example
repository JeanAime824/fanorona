# Port d'écoute du serveur backend (par exemple 9005 sur votre serveur local)
PORT=9005

# Configuration optionnelle pour l'hébergement séparé (ex: front sur Vercel, backend sur votre serveur)
# Si laissé vide et servi ensemble, le client communique directement avec l'hôte courant
VITE_BACKEND_URL=

# Clé secrète pour signer les jetons JWT des sessions joueurs (optionnelle)
JWT_SECRET=
