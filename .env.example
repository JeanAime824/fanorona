# Configuration optionnelle pour l'hébergement local ou personnalisé
# Par défaut, si laissé vide, le client communique directement avec le même serveur (ex: http://localhost:3000)
VITE_BACKEND_URL=

# Clé secrète pour signer les jetons JWT des sessions joueurs (valeur par défaut intégrée si non définie)
JWT_SECRET=
